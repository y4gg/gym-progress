{
  "name": "gym-progress",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-service-worker.mjs",
    "start": "NODE_ENV=production sh scripts/start.sh --bun next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:account": "bun test components/account/change-password-dialog.test.tsx && bun test 'app/(account)/account/actions.test.ts'",
    "test:auth": "bun test 'app/(account)/auth-form.test.tsx' && bun test lib/magic-link.test.ts",
    "test:exercise": "bun test components/screens/exercise.test.tsx && bun test components/screens/exercise-logs.test.tsx && bun test lib/exercise-history.test.ts",
    "test:launchpad": "bun test components/use-launchpad-gestures.test.tsx",
    "test:pwa": "bun test components/pwa-onboarding.test.tsx",
    "test:offline": "node --test scripts/service-worker.test.mjs && bun test lib/sync.test.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.25",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.38.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "happy-dom": "^21.0.4",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
